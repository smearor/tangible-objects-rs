# TUI - status line
status-connecting = verbinde…
status-filter-rejected = setFilterMode { $mode } abgelehnt
status-daemon-error = Daemon-Fehler: { $error }
status-ready = { $touches } Touch-Punkte, { $tangibles } Figuren - f Filter  r neu laden  q beenden

# TUI - pane titles
title-slots = slots ({ $count })
title-tangibles = figuren ({ $count })
title-fields = felder
title-field-sets = feld-sets ({ $count })
title-profiles = profile ({ $count })
title-filter-metrics = filter/metriken
title-events = ereignisse
title-surface = fläche { $width }x{ $height } mm

# TUI - tabs + inline markers
tab-overview = [1] übersicht
tab-live = [2] live
marker-pending = ausstehend
marker-window = +fenster
field-suppress = unterdrückt
field-info = info

# TUI - metrics pane + log
metrics-filter = filter: { $mode }   [f wechseln]
metrics-stages = stufen: { $count }
metrics-frames = frames { $frames } verfolgt { $tracked }
metrics-contacts = kontakte { $contacts } figuren { $tangibles }
log-lagged = rückstand - { $count } ereignisse übersprungen
